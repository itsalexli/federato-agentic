# Federato HTN 2026 API credentials (from organizers)
FEDERATO_CLIENT_ID=your_client_id_here
FEDERATO_CLIENT_SECRET=your_client_secret_here

# Optional: enables LLM-written explanations and natural-language goal parsing.
# Without it the agent falls back to deterministic templated explanations.
ANTHROPIC_API_KEY=

# Optional: set to 0 to disable external enrichment (Open-Meteo / OpenFEMA)
ENRICHMENT_ENABLED=1

# Optional: set to 0 to skip the critic that verifies each query result against
# the hypothesis the planner stated. On by default; roughly doubles the LLM
# calls per question. Off still records hypotheses, it just never checks them.
CRITIC_ENABLED=1
